  <rows>
   <row>
    <id><![CDATA[147]]></id>
    <name><![CDATA[CompetenceReport]]></name>
    <key><![CDATA[bEnabled]]></key>
    <value><![CDATA["1"]]></value>
   </row>
   <row>
    <id><![CDATA[148]]></id>
    <name><![CDATA[CompetenceReport]]></name>
    <key><![CDATA[bEnableAPI]]></key>
    <value><![CDATA["0"]]></value>
   </row>
   <row>
    <id><![CDATA[149]]></id>
    <name><![CDATA[CompetenceReport]]></name>
    <key><![CDATA[sXMLConfiguration]]></key>
    <value><![CDATA["<?xml version=\"1.0\" encoding=\"UTF-8\"?>\r\n<report xmlns:xsi=\"http:\/\/www.w3.org\/2001\/XMLSchema-instance\" xsi:noNamespaceSchemaLocation=\"..\/..\/plugins\/CompetenceReport\/report\/samples\/competence-report.xsd\">\r\n    <config>\r\n        <mode>knowledge<\/mode>\r\n\t\t<language code=\"de\">limesurvey-HSF-Quiz-BBB-v01.txt<\/language>\r\n        <css>style-quizzes.css<\/css>\r\n        <image type=\"cover-logo\">logo.png<\/image>\r\n        <image type=\"cover-image\">cover.jpg<\/image>\r\n        <image type=\"footer-logo\">logo.png<\/image>\r\n        <showCorrectAnswer>true<\/showCorrectAnswer>\r\n        <showReferenceValue>false<\/showReferenceValue>\r\n    <\/config>\r\n\r\n    <common>\r\n        <headerTitle>BigBlueButton-Quiz<\/headerTitle>\r\n    <\/common>\r\n\r\n    <pages>\r\n        <page id=\"\" type=\"cover\" header=\"false\" pagebreak-after=\"true\" print=\"true\">\r\n            <block type=\"cover-image\" class=\"cover-image\"\/>\r\n\t\t\t<block type=\"h1\" class=\"cover-name\">BigBlueButton-Quiz<\/block>\r\n            <block type=\"h1\" class=\"cover-title\">Ergebnisbericht<\/block>\r\n            <block type=\"date\" class=\"cover-date\"\/>\r\n            <block type=\"cover-logo\" class=\"cover-logo\"\/>\r\n            <block type=\"paragraph\" class=\"cover-link\"><![CDATA[<a href=\"https:\/\/www.hs-fulda.de\" target=\"_blank\">www.hs-fulda.de<\/a>]] ><\/block>\r\n        <\/page>\r\n\r\n        <page id=\"\" type=\"intro\" pagebreak-after=\"true\" screen=\"true\" print=\"true\">\r\n            <block type=\"h1\" class=\"\">Ergebnisbericht<\/block>\r\n            <block type=\"paragraph\" class=\"\"><![CDATA[Sie haben das BigBlueButton-Quiz erfolgreich beendet. Im Nachfolgenden sehen Sie Ihr Gesamtergebnis.]] ><\/block>\r\n            <block type=\"print-button\">Drucken<\/block>\r\n\t\t\t<block type=\"restart-button\">Quiz wiederholen<\/block>\r\n            <block type=\"h1\" class=\"\">Ihr Gesamtergebnis<\/block>\r\n            <block type=\"total-competence\" class=\"\" key=\"total-competence\" key-header=\"\" key-footer=\"\"\/>\r\n<!--\r\n\t\t\t<block type=\"total-competence-conclusion\" class=\"\"\/>\r\n            <block type=\"h1\" class=\"\">Ihre Ergebnisse im \u00dcberblick<\/block>\r\n            <block type=\"competence-areas-overview\" key=\"overview-header-area\" key-result=\"overview-header-result\" key-graph=\"overview-header-graph\" key-result-content=\"overview-content-result\"\/>\r\n-->\r\n        <\/page>\r\n\r\n        <page id=\"\" type=\"competence-areas-eval\" pagebreak-after=\"true\" screen=\"true\" print=\"true\">\r\n<!--\r\n            <block type=\"h1\" class=\"\">Ihre Ergebnisse im Detail<\/block>\r\n-->\r\n            <block type=\"competence-area\" competence-area-id=\"bbb_quiz\" key-header=\"recommendation\"\/>\r\n        <\/page>\r\n\r\n        <page id=\"\" type=\"legal\" pagebreak-after=\"false\" screen=\"true\" print=\"true\">\r\n            <block type=\"h1\" class=\"\">Rechtliche Hinweise und Kontakt<\/block>\r\n\t\t\t<block type=\"paragraph\" class=\"\">\r\n\t\t\t\t<![CDATA[\r\n\t\t\t\t\t<p>Dieses Quiz dient der spielerischen Wissensvermittlung und dem Informationsaustausch innerhalb der Hochschule. Die Inhalte wurden mit Sorgfalt erstellt; f\u00fcr die Richtigkeit, Vollst\u00e4ndigkeit und Aktualit\u00e4t der Fragen und Antworten wird jedoch keine Gew\u00e4hr \u00fcbernommen. Haftungsanspr\u00fcche gegen den Betreiber f\u00fcr Sch\u00e4den, die durch die Nutzung oder Nichtnutzung der bereitgestellten Informationen entstehen, sind grunds\u00e4tzlich ausgeschlossen.<\/p>]] >\r\n\t\t\t<\/block>\r\n\t\t\t<block type=\"paragraph\" class=\"\">\r\n\t\t\t\t<![CDATA[\r\n\t\t\t\t\t<p><strong>Das Quiz ist ein Angebot von (Dienstanbieter):<\/strong><\/p><p>Hochschule Fulda<br>\r\n\t\t\t\t\t Leipziger Stra\u00dfe 123<br>\r\n\t\t\t\t\t 36037 Fulda<br>\r\n\t\t\t\t\t www.hs-fulda.de<\/p>]] >\r\n\t\t\t<\/block>\r\n\t\t\t<block type=\"paragraph\" class=\"\">\r\n\t\t\t\t<![CDATA[\r\n\t\t\t\t\t<p><strong>Technischer Betrieb und Entwicklung:<\/strong><\/p><p>Enterra GmbH<br>\r\n\t\t\t\t\t Carl-Benz-Stra\u00dfe 5<br>\r\n\t\t\t\t\t 68723 Schwetzingen<br>\r\n\t\t\t\t\t www.enterra.de<\/p>]] >\r\n\t\t\t<\/block>\r\n        <\/page>\r\n    <\/pages>\r\n\r\n\t<competenceLevels>\r\n\t\t<competenceLevel id=\"foundation\" min=\"0\" max=\"20\" key=\"level-1\">\r\n\t\t\t<block type=\"paragraph\" class=\"\"><\/block>\r\n\t\t<\/competenceLevel>\r\n\t\t<competenceLevel id=\"intermediate\" min=\"20\" max=\"55\" key=\"level-2\">\r\n\t\t\t<block type=\"paragraph\" class=\"\"><\/block>\r\n\t\t<\/competenceLevel>\r\n\t\t<competenceLevel id=\"advanced\" min=\"55\" max=\"80\" key=\"level-3\">\r\n\t\t\t<block type=\"paragraph\" class=\"\"><\/block>\r\n\t\t<\/competenceLevel>\r\n\t\t<competenceLevel id=\"highly_specialized\" min=\"80\" max=\"100\" key=\"level-4\">\r\n\t\t\t<block type=\"paragraph\" class=\"\"><\/block>\r\n\t\t<\/competenceLevel>\r\n\t<\/competenceLevels>\r\n\r\n    <competenceAreas>\r\n        <competenceArea id=\"bbb_quiz\" key=\"bbb_quiz_c\">\r\n            <singleCompetence id=\"bbb_quiz_c_1\" key=\"bbb_quiz_c_1\">\r\n                <questions>\r\n\t\t\t\t\t<question code=\"Q00\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_2\" key=\"bbb_quiz_c_2\">\r\n                <questions>\r\n                    <question code=\"Q01\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_3\" key=\"bbb_quiz_c_3\">\r\n                <questions>\r\n                    <question code=\"Q02\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_4\" key=\"bbb_quiz_c_4\">\r\n                <questions>\r\n                    <question code=\"Q03\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_5\" key=\"bbb_quiz_c_5\">\r\n                <questions>\r\n                    <question code=\"Q04\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_6\" key=\"bbb_quiz_c_6\">\r\n                <questions>\r\n                    <question code=\"Q05\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_7\" key=\"bbb_quiz_c_7\">\r\n                <questions>\r\n                    <question code=\"Q06\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_8\" key=\"bbb_quiz_c_8\">\r\n                <questions>\r\n                    <question code=\"Q07\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_9\" key=\"bbb_quiz_c_9\">\r\n                <questions>\r\n                    <question code=\"Q08\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_10\" key=\"bbb_quiz_c_10\">\r\n                <questions>\r\n                    <question code=\"Q09\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_11\" key=\"bbb_quiz_c_11\">\r\n                <questions>\r\n                    <question code=\"Q10\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_12\" key=\"bbb_quiz_c_12\">\r\n                <questions>\r\n                    <question code=\"Q11\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_13\" key=\"bbb_quiz_c_13\">\r\n                <questions>\r\n                    <question code=\"Q12\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_14\" key=\"bbb_quiz_c_14\">\r\n                <questions>\r\n                    <question code=\"Q13\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_15\" key=\"bbb_quiz_c_15\">\r\n                <questions>\r\n                    <question code=\"Q14\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_16\" key=\"bbb_quiz_c_16\">\r\n                <questions>\r\n                    <question code=\"Q15\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_17\" key=\"bbb_quiz_c_17\">\r\n                <questions>\r\n                    <question code=\"Q16\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_18\" key=\"bbb_quiz_c_18\">\r\n                <questions>\r\n                    <question code=\"Q17\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_19\" key=\"bbb_quiz_c_19\">\r\n                <questions>\r\n                    <question code=\"Q18\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n            <singleCompetence id=\"bbb_quiz_c_20\" key=\"bbb_quiz_c_20\">\r\n                <questions>\r\n                    <question code=\"Q19\"\/>\r\n                <\/questions>\r\n            <\/singleCompetence>\r\n<!--\t\t\t\r\n            <recommendation>\r\n                <level level-id=\"foundation\" key=\"bbb_quiz_c_level-1\"\/>\r\n                <level level-id=\"intermediate\" key=\"bbb_quiz_c_level-2\"\/>\r\n                <level level-id=\"advanced\" key=\"bbb_quiz_c_level-3\"\/>\r\n                <level level-id=\"highly_specialized\" key=\"bbb_quiz_c_level-4\"\/>\r\n            <\/recommendation>\r\n-->\r\n        <\/competenceArea>\r\n\t<\/competenceAreas>\r\n\r\n    <referenceGroups type=\"default\">\r\n        <referenceGroup>\r\n            <competenceArea id=\"bbb_quiz\" value=\"12\" min=\"10\" max=\"14\"\/>\r\n        <\/referenceGroup>\r\n    <\/referenceGroups>\r\n<\/report>\r\n\r\n"]]></value>
   </row>
